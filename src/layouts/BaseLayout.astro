    <!-- Preload LCP-critical fonts so they start downloading in parallel with the
         HTML parse, not after CSS is discovered. Was 8 woff2 files racing at
         1,400-1,700 ms each; these two now start on the first byte. -->
    <link rel="preload" href={latoBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairH1} as="font" type="font/woff2" crossorigin />

    <!-- WebSite + Organization + Person schema (site-wide AEO signals) -->
    <script type="application/ld+json" set:html={siteSchema} />
  </head>
