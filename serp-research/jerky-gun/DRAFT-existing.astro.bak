const heroImage = '/images/jerky-gun.webp';

const recipe = {
  name: 'Ground Beef Jerky Gun Recipe',
  description: 'Classic ground-beef jerky pressed through a jerky gun into uniform strips — savory, tender, and safe. Cured with Prague Powder #1 and dehydrated at USDA-approved 160°F.',
  prepTime: 'PT20M',
  cookTime: 'PT5H',
  totalTime: 'PT17H20M',
  recipeYield: 'About 12 oz finished jerky (from 2 lb raw)',
  image: heroImage,
  ingredients: [
    '2 lb 90/10 lean ground beef (or leaner)',
    '1/2 teaspoon Prague Powder #1 (curing salt)',
    '2 teaspoons kosher salt',
    '1 tablespoon coarse black pepper',
    '2 teaspoons garlic powder',
    '2 teaspoons onion powder',
    '1 teaspoon smoked paprika',
    '2 tablespoons soy sauce',
    '1 tablespoon Worcestershire sauce',
    '1 teaspoon liquid smoke (optional, if not smoking)',
    '1 tablespoon brown sugar',
