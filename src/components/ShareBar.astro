---
// Social share bar — pure href share intents + vanilla-JS copy link.
// No third-party scripts. Per-page url/title/image are passed by the layout.
interface Props {
  url: string;        // page canonical URL
  title: string;      // share text / Pinterest description
  image: string;      // absolute image URL for Pinterest media
  label?: string;     // eyebrow label
}
const { url, title, image, label = 'Share this recipe' } = Astro.props;
const enc = encodeURIComponent;

const pinterestUrl = `https://pinterest.com/pin/create/button/?url=${enc(url)}&media=${enc(image)}&description=${enc(title)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
const xUrl = `https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`;
---
<div class="share-bar">
  <span class="share-bar__label">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"/></svg>
    {label}
  </span>
  <div class="share-bar__btns">
    <a class="share-btn share-btn--pin" href={pinterestUrl} target="_blank" rel="noopener nofollow" aria-label="Save to Pinterest">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.688 0 1.028-.653 2.567-.992 3.992-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345c-.091.378-.293 1.194-.332 1.361-.052.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.966 7.398 6.931 0 4.136-2.607 7.464-6.226 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/></svg>
      <span class="share-btn__txt">Save</span>
    </a>
    <a class="share-btn share-btn--fb" href={facebookUrl} target="_blank" rel="noopener nofollow" aria-label="Share on Facebook">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      <span class="share-btn__txt">Facebook</span>
    </a>
    <a class="share-btn share-btn--x" href={xUrl} target="_blank" rel="noopener nofollow" aria-label="Share on X">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span class="share-btn__txt">Post</span>
    </a>
    <button class="share-btn share-btn--copy js-share-copy" type="button" data-url={url} aria-label="Copy link to this page">
      <svg class="ic-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      <svg class="ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <span class="share-btn__txt share-btn__lbl">Copy link</span>
    </button>
  </div>
</div>

<script>
  // One delegated handler covers every share bar on the page (top + bottom).
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const btn = target && target.closest ? target.closest('.js-share-copy') : null;
    if (!btn) return;
    const url = btn.getAttribute('data-url') || location.href;
    const lbl = btn.querySelector('.share-btn__lbl');
    const restore = lbl ? lbl.textContent : '';
    const done = () => {
      if (lbl) lbl.textContent = 'Copied!';
      btn.classList.add('is-copied');
      window.setTimeout(() => {
        if (lbl) lbl.textContent = restore;
        btn.classList.remove('is-copied');
      }, 1600);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(done).catch(done);
    } else {
      const ta = document.createElement('textarea');
      ta.value = url;
      ta.setAttribute('readonly', '');
      ta.style.position = 'absolute';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (err) { /* no-op */ }
      document.body.removeChild(ta);
      done();
    }
  });
</script>
