---
import Seo from '../components/Seo.astro';
import SearchBox from '../components/SearchBox.astro';
import SocialLinks from '../components/SocialLinks.astro';

// Self-hosted fonts (was render-blocking Google Fonts CSS + 2 third-party origins).
// Only the weights actually used in global.css — italics limited to the 400s that render.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
// Playfair Display as a variable font — one woff2 file covers weights 400-900
// (instead of 5 static-weight CSS files pulling 5 separate woff2 files each).
// Same weight coverage; 3 fewer woff2 requests on the critical path.
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource/anton/400.css';
import '../styles/global.css';

// LCP-critical font URLs (resolved at build time by Vite → hashed filenames in dist/_astro/).
// Preloaded in <head> so they don't wait behind CSS discovery. Latin subset only —
// the site is English-only and skipping other subsets saves bytes on the critical path.
// Was: 8 woff2 files racing at 1,400-1,700 ms each. Now: these 2 start immediately.
import latoBody from '@fontsource/lato/files/lato-latin-400-normal.woff2?url';
// Variable-font preload — this single file serves every Playfair weight we use.
import playfairH1 from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
}
const props = Astro.props;

const siteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://allaboutjerky.com/#website',
      name: 'All About Jerky',
      url: 'https://allaboutjerky.com',
      description: 'Homemade beef jerky recipes, marinade guides, and step-by-step drying methods for dehydrator, oven, smoker, and air fryer.',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://allaboutjerky.com/?s={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://allaboutjerky.com/#organization',
      name: 'All About Jerky',
      url: 'https://allaboutjerky.com',
      foundingDate: '2024',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://allaboutjerky.com/#logo',
        url: 'https://allaboutjerky.com/images/og-default.webp',
        width: 1200,
        height: 630,
        contentUrl: 'https://allaboutjerky.com/images/og-default.webp',
      },
      sameAs: [
        'https://www.pinterest.com/allaboutjerky',
        'https://www.facebook.com/allaboutjerky',
        'https://www.instagram.com/allaboutjerky',
        'https://twitter.com/allaboutjerky',
        'https://www.youtube.com/@allaboutjerky',
      ],
    },
    {
      '@type': 'Person',
      '@id': 'https://allaboutjerky.com/about/#cole-mercer',
      name: 'Cole Mercer',
      url: 'https://allaboutjerky.com/about/',
      jobTitle: 'Pitmaster & Recipe Developer',
      description: 'Bozeman, Montana pitmaster with 15+ years of beef jerky and smoked meat experience.',
      worksFor: { '@id': 'https://allaboutjerky.com/#organization' },
      knowsAbout: ['beef jerky', 'food dehydration', 'meat smoking', 'jerky marinades', 'food preservation', 'USDA food safety', 'curing meats'],
    },
  ],
});
---
<!doctype html>
<html lang="en">
