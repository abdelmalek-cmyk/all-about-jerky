---
interface Props {
  name: string;
  description: string;
  image: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  ingredients: string[];
  instructions: string[];
  category: string;
  cuisine: string;
  datePublished: string;
  dateModified?: string;
  url?: string;
  nutrition?: Record<string, string>;
}
const p = Astro.props;
const base = 'https://allaboutjerky.com';
const pageUrl = p.url ?? base;

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': `${pageUrl}#recipe`,
  name: p.name,
  description: p.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'en-US',
  image: {
    '@type': 'ImageObject',
    url: `${base}${p.image}`,
    width: 1200,
    height: 800,
  },
  author: {
    '@type': 'Person',
    '@id': `${base}/about/#cole-mercer`,
    name: 'Cole Mercer',
    url: `${base}/about/`,
    jobTitle: 'Pitmaster & Recipe Developer',
    knowsAbout: ['beef jerky', 'food dehydration', 'meat smoking', 'jerky marinades', 'food preservation'],
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${base}/#organization`,
    name: 'All About Jerky',
    url: base,
    logo: {
      '@type': 'ImageObject',
      url: `${base}/images/og-default.webp`,
      width: 1200,
      height: 630,
    },
  },
  datePublished: p.datePublished,
  ...(p.dateModified && { dateModified: p.dateModified }),
  prepTime: p.prepTime,
  cookTime: p.cookTime,
  totalTime: p.totalTime,
  recipeYield: p.recipeYield,
  recipeCategory: p.category,
  recipeCuisine: p.cuisine,
  recipeIngredient: p.ingredients,
  recipeInstructions: p.instructions.map((step, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Step ${i + 1}`,
    text: step,
  })),
};

if (p.nutrition) {
  schema.nutrition = {
    '@type': 'NutritionInformation',
    ...p.nutrition,
  };
}
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
