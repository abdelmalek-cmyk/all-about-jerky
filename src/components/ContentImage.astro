---
import { getImageDims } from '../lib/image-dims.mjs';

interface Props {
  src: string;
  alt: string;
  /** First image above the fold — loads eagerly with high priority (LCP). */
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;

// Renders nothing if the file isn't present yet, so a page never ships
// broken <img> tags. Dimensions come from the real file (CLS prevention).
const dims = getImageDims(src);

// Responsive variants (from scripts/generate-responsive.mjs) so small screens
// don't download the full-width hero. Rule must match that script exactly.
const w = dims?.width ?? 0;
const base = src.replace(/\.webp$/i, '');
const srcsetParts = [];
if (w > 480) srcsetParts.push(`${base}-480.webp 480w`);
if (w > 640) srcsetParts.push(`${base}-640.webp 640w`);
if (w > 960) srcsetParts.push(`${base}-960.webp 960w`);
if (srcsetParts.length) srcsetParts.push(`${src} ${w}w`);
const srcset = srcsetParts.length ? srcsetParts.join(', ') : undefined;
// Actual layout: .page-content .container caps at 820px on desktop; on smaller
// viewports the image spans 100vw minus 3rem of combined side padding. This
// gives the browser a display width closer to reality so it doesn't over-pick.
const sizes = srcset ? '(min-width: 820px) 800px, calc(100vw - 3rem)' : undefined;
---
{dims && (
  <img
    src={src}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={dims.width}
    height={dims.height}
    style="width:100%;border-radius:8px;margin:1.5rem 0;"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? undefined : 'async'}
  />
)}
