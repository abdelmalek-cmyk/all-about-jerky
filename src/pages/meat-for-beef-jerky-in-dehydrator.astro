      <tr><td><strong>Flank steak</strong></td><td>~5%</td><td>Good with sharp knife</td><td>★★★★☆</td><td>Pricey; excellent when on sale.</td></tr>
      <tr><td><strong>Sirloin tip</strong></td><td>~6%</td><td>Good</td><td>★★★☆☆</td><td>Usable; better as steak.</td></tr>
