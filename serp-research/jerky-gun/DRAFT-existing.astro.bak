const title = 'Jerky Gun: How to Use It, Best Brands & Recipe (2026)';
const description = 'Complete jerky gun guide — how to use it, best brands (LEM, Nesco, Weston), a ground beef jerky recipe, and honest brand comparison. From a Montana pitmaster.';
