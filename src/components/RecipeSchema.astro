---
import { getSchemaImages } from '../lib/image-dims.mjs';

interface Props {
  name: string;
  description: string;
  image: string;
  prepTime: string;
  cookTime: string;
  totalTime: string;
  recipeYield: string;
  ingredients: string[];
  instructions: string[];
  category: string;
  cuisine: string;
  keywords?: string;
  datePublished: string;
  dateModified?: string;
  url?: string;
  nutrition?: Record<string, string>;
}
const p = Astro.props;
const base = 'https://allaboutjerky.com';
const pageUrl = p.url ?? base;
const schemaImages = getSchemaImages(p.image);

// Hard build gate. Twice we shipped a pillar before its recipe image landed,
// and Google Search Console flagged Recipe rich-results as invalid ("Missing
// field 'image'"). The doc guard in /new-article STEP 7 wasn't enough — this
// throw makes the failure mode physical: `astro build` cannot produce a
// broken static file. Dev mode keeps the silent-omit so writers can iterate
// on a page before its .webp exists; PROD builds must have the image.
if (schemaImages.length === 0 && import.meta.env.PROD) {
  throw new Error(
    `[RecipeSchema build gate] Recipe "${p.name}" at ${pageUrl} references ` +
    `image "${p.image}" but no matching file was found in the image manifest ` +
    `(neither the base .webp nor any of the -16x9 / -4x3 / -1x1 crops). ` +
    `Fix: (1) place ${p.image} in public/images/, then ` +
    `(2) run \`node scripts/generate-crops.mjs\` to produce the schema crops, then ` +
    `(3) run \`npm run build\` again. Never push a pillar with a Recipe card ` +
    `before its image files are on disk — Google penalizes empty-image Recipe schema.`
  );
}

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': `${pageUrl}#recipe`,
  name: p.name,
  description: p.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'en-US',
  // Omit entirely rather than emit an empty array, which validators flag as
  // an error. Reappears automatically once the image file exists.
  ...(schemaImages.length > 0 && {
    image: schemaImages.map((img) => ({
      '@type': 'ImageObject',
      url: `${base}${img.url}`,
      width: img.width,
      height: img.height,
    })),
  }),
  ...(p.keywords && { keywords: p.keywords }),
  author: {
    '@type': 'Person',
    '@id': `${base}/about/#cole-mercer`,
    name: 'Cole Mercer',
    url: `${base}/about/`,
    jobTitle: 'Pitmaster & Recipe Developer',
    knowsAbout: ['beef jerky', 'food dehydration', 'meat smoking', 'jerky marinades', 'food preservation'],
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${base}/#organization`,
    name: 'All About Jerky',
    url: base,
    logo: {
      '@type': 'ImageObject',
      url: `${base}/images/og-default.webp`,
      width: 1200,
      height: 630,
    },
  },
  datePublished: p.datePublished,
  ...(p.dateModified && { dateModified: p.dateModified }),
  prepTime: p.prepTime,
  cookTime: p.cookTime,
  totalTime: p.totalTime,
  recipeYield: p.recipeYield,
  recipeCategory: p.category,
  recipeCuisine: p.cuisine,
  recipeIngredient: p.ingredients,
  recipeInstructions: p.instructions.map((step, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: `Step ${i + 1}`,
    text: step,
  })),
};

if (p.nutrition) {
  schema.nutrition = {
    '@type': 'NutritionInformation',
    ...p.nutrition,
  };
}
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
